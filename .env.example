# Copia este archivo como .env solo si necesitas cambiar los valores por defecto.
# Las rutas relativas se resuelven desde la carpeta en la que se ejecuta el comando.

HOTEL_ML_DATA_DIR=data
HOTEL_ML_MODELS_DIR=models
HOTEL_ML_OUTPUTS_DIR=outputs

# Dirección de la API que consulta la interfaz.
HOTEL_ML_API_URL=http://127.0.0.1:8000
